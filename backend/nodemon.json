{
  "watch": [
    "*.js",
    "controllers/",
    "routes/",
    "middleware/",
    "utils/",
    "prisma/"
  ],
  "ext": "js,json,prisma",
  "ignore": [
    "node_modules/",
    "*.log",
    "uploads/",
    "public/"
  ],
  "env": {
    "NODE_ENV": "development"
  },
  "delay": "1000",
  "verbose": true
}
