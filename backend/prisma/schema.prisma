generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                   String     @id @default(uuid())
  email                String?    @unique
  name                 String
  password             String?
  phone                String?    @unique
  token                String?
  time                 DateTime   @updatedAt
  has_hotel            Boolean    @default(false)
  has_restr            Boolean    @default(false)
  is_admin             Boolean    @default(false)
  is_team_member       Boolean    @default(false)
  verified             Boolean    @default(false)
  p_verified           Boolean    @default(false)
  address              String?
  googleId             String?    @unique
  mobile               String?    @unique
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  first_name           String?
  last_name            String?
  otps                 OTP[]
  blogs_name           blogs[]
  bookings             bookings[]
  hotels_name          hotels[]
  ratings              rating[]
  requests             requests[]
  restr_name           restr[]
  reviews              review[]
}

model OTP {
  id        String   @id @default(uuid())
  mobile    String
  otp       String
  type      OTPType
  expiresAt DateTime
  time      DateTime @default(now())
  userId    String?
  user      users?   @relation(fields: [userId], references: [id])
}

model hotels {
  id               String     @id @default(uuid())
  name             String
  address          String
  gmap             String
  totalRoom        Int        @default(2)
  maxInRoom        Int        @default(2)
  details          String?
  rate             Decimal    @default(0.0)
  s1               String     @default("")
  s2               String     @default("")
  s3               String     @default("")
  s4               String     @default("")
  wifi             Boolean    @default(false)
  tv               Boolean    @default(false)
  kitchen          Boolean    @default(false)
  washingmachine   Boolean    @default(false)
  parking          Boolean    @default(false)
  ac               Boolean    @default(false)
  pool             Boolean    @default(false)
  fireextinguisher Boolean    @default(false)
  firstaid         Boolean    @default(false)
  ownerId          String
  videoUrl         String?
  maxAdults        Int        @default(16)
  maxChildren      Int        @default(5)
  maxInfants       Int        @default(5)
  maxPets          Int        @default(2)
  guestAccess      String     @default("Entire place")
  propertyType     String     @default("House")
  geyser           Boolean    @default(false)
  microwave        Boolean    @default(false)
  waterFilter      Boolean    @default(false)
  averageRating    Float      @default(0.0)
  totalRatings     Int        @default(0)
  petCharge        Decimal    @default(0.0)
  extraAdultCharge Decimal    @default(0.0)
  icalLink         String?
  bookings         bookings[]
  images           himages[]
  staffimages      staffimages[]
  owner            users      @relation(fields: [ownerId], references: [id])
  ratings          rating[]
  reviews          review[]
}

model restr {
  id      String    @id @default(uuid())
  name    String
  address String
  gmap    String
  ownerId String
  owner   users     @relation(fields: [ownerId], references: [id])
  images  rimages[]
}

model blogs {
  id       String @id @default(uuid())
  title    String
  content  String
  authorId String
  author   users  @relation(fields: [authorId], references: [id])
}

model himages {
  id      String  @id @default(uuid())
  url     String
  name    String?
  hotelId String
  hotel   hotels  @relation(fields: [hotelId], references: [id])
}

model staffimages {
  id      String  @id @default(uuid())
  url     String
  name    String?
  hotelId String
  hotel   hotels  @relation(fields: [hotelId], references: [id])
}

model rimages {
  id      String @id @default(uuid())
  url     String
  name    String
  restrId String
  rest    restr  @relation(fields: [restrId], references: [id])
}

model requests {
  id              String    @id @default(uuid())
  email           String
  message         String
  phone           String
  type            UserType
  userId          String
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime  @default(now())
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?
  status          String?   @default("pending")
  updatedAt       DateTime  @updatedAt
  user            users     @relation(fields: [userId], references: [id])
}

model bookings {
  id      String   @id @default(uuid())
  email   String
  message String?
  phone   String?
  time    DateTime @updatedAt
  from    DateTime
  to      DateTime
  hotelId String
  userId  String
  status  String   @default("pending")
  hotel   hotels   @relation(fields: [hotelId], references: [id])
  user    users    @relation(fields: [userId], references: [id])
  payment payment?
  rating  rating?
  review  review?
}

model payment {
  id                  String   @id @default(uuid())
  razorpay_order_id   String
  razorpay_payment_id String
  razorpay_signature  String
  date                DateTime @default(now())
  bookingId           String   @unique
  booking             bookings @relation(fields: [bookingId], references: [id])
}

model rating {
  id        String   @id @default(uuid())
  rating    Int
  bookingId String   @unique
  hotelId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   bookings @relation(fields: [bookingId], references: [id])
  hotel     hotels   @relation(fields: [hotelId], references: [id])
  user      users    @relation(fields: [userId], references: [id])
}

model review {
  id        String   @id @default(uuid())
  content   String
  rating    Int
  bookingId String   @unique
  hotelId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isVisible Boolean  @default(true)
  booking   bookings @relation(fields: [bookingId], references: [id])
  hotel     hotels   @relation(fields: [hotelId], references: [id])
  user      users    @relation(fields: [userId], references: [id])
}

enum OTPType {
  LOGIN
  SIGNUP
  RESET
  EMAIL_RECOVERY
  PHONE_RECOVERY
  EMAIL_ADD
  EMAIL_SIGNUP
}

enum UserType {
  admin
  hotelowner
  restaurantowner
}
